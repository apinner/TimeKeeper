# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://timekeeper:changeme@postgres:5432/timekeeper?schema=public"
POSTGRES_USER=timekeeper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=timekeeper

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://timekeeper.example.com
AUTH_TRUST_HOST=true              # required behind your own reverse proxy

# ---------------------------------------------------------------------------
# Active Directory (LDAP)
#
# Sign-in binds to the directory as the person signing in. On ldap:// port 389
# a simple bind sends their password across the network in clear text; switch
# the scheme to ldaps:// (port 636) or set LDAP_STARTTLS=true to encrypt it.
# ---------------------------------------------------------------------------
LDAP_URL=ldap://dc01.example.local:389
LDAP_BASE_DN=DC=example,DC=local

# Appended when someone types a bare username, so "alex.pinner" and
# "alex.pinner@example.co.uk" both work.
LDAP_UPN_SUFFIX=@example.co.uk

# Only members of this group may sign in. Leave empty to allow anyone in the
# directory. Nested groups are followed.
LDAP_ACCESS_GROUP_DN=CN=TimeKeeper-Users,OU=Groups,DC=example,DC=local

# Read-only service account. Used only by the nightly sync and to resolve a
# manager who has not signed in yet — sign-in itself does not need it.
LDAP_BIND_DN=CN=svc-timekeeper,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=

LDAP_STARTTLS=false
LDAP_TLS_REJECT_UNAUTHORIZED=true  # false only for a self-signed DC certificate
LDAP_NESTED_GROUPS=true
LDAP_TIMEOUT_MS=10000

# UPN of the first administrator. Granted SYSADMIN on their first sign-in.
BOOTSTRAP_ADMIN_UPN=

# ---------------------------------------------------------------------------
# Email (SMTP relay). Leave SMTP_HOST empty to log mail instead of sending.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TimeKeeper <timekeeper@example.com>"

# Base URL used in email links (defaults to AUTH_URL).
APP_URL=https://timekeeper.example.com

# ---------------------------------------------------------------------------
# Where the port is published.
#
# 127.0.0.1 (default) publishes on the server's loopback only, for a reverse
# proxy on the same host. Set 0.0.0.0 to reach it directly from your network,
# e.g. http://192.168.1.50:3000.
#
# Direct access is fine for a first look, but single sign-on will not work over
# plain http: Entra ID rejects http:// redirect URIs for anything other than
# localhost. AUTH_URL must exactly match the address people type, and for real
# use that means an HTTPS address through your proxy.
# ---------------------------------------------------------------------------
APP_BIND=127.0.0.1
APP_PORT=3000

# ---------------------------------------------------------------------------
# Scheduled jobs (in-process cron). Set to false on any replica that should
# not run them.
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true
TZ=Europe/London
