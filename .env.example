# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://timekeeper:changeme@postgres:5432/timekeeper?schema=public"
POSTGRES_USER=timekeeper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=timekeeper

# ---------------------------------------------------------------------------
# Auth.js / Microsoft Entra ID (Office 365 SSO)
# Create a single-tenant app registration, then see docs/SETUP.md.
# ---------------------------------------------------------------------------
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://timekeeper.example.com
AUTH_TRUST_HOST=true              # required behind your own reverse proxy
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# UPN of the first administrator. Granted SYSADMIN on their first sign-in.
BOOTSTRAP_ADMIN_UPN=

# ---------------------------------------------------------------------------
# Email (SMTP relay). Leave SMTP_HOST empty to log mail instead of sending.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TimeKeeper <timekeeper@example.com>"

# Base URL used in email links (defaults to AUTH_URL).
APP_URL=https://timekeeper.example.com

# ---------------------------------------------------------------------------
# Scheduled jobs (in-process cron). Set to false on any replica that should
# not run them.
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true
TZ=Europe/London
