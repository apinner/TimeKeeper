# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://timekeeper:changeme@postgres:5432/timekeeper?schema=public"
POSTGRES_USER=timekeeper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=timekeeper

# ---------------------------------------------------------------------------
# Sessions
#
# AUTH_SECRET also encrypts the directory and mail passwords held in the
# database. Changing it signs everyone out and makes those stored passwords
# unreadable, so they have to be entered again in Admin.
# ---------------------------------------------------------------------------
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://timekeeper.example.com
AUTH_TRUST_HOST=true              # required behind your own reverse proxy

# ---------------------------------------------------------------------------
# Where the port is published
#
# 127.0.0.1 (default) publishes on the server's loopback only, for a reverse
# proxy on the same host. Set 0.0.0.0 to reach it directly from your network.
# ---------------------------------------------------------------------------
APP_BIND=127.0.0.1
APP_PORT=3000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true             # set false on any replica that should not run jobs
TZ=Europe/London

# ---------------------------------------------------------------------------
# Everything else is configured in the application itself:
#
#   Active Directory   Admin → Authentication
#   Mail relay         Admin → Email
#   Leave year, allowances, scheduled job times
#                      Admin → Company settings
#
# On first run, open TimeKeeper in a browser: while nobody can sign in, it
# offers a one-time page to create the administrator account.
#
# Upgrading from a version that used LDAP_* and SMTP_* variables? Leave them in
# place for one start. They are copied into the database automatically, and can
# then be deleted.
# ---------------------------------------------------------------------------
