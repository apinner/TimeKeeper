# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://timekeeper:changeme@postgres:5432/timekeeper?schema=public"
POSTGRES_USER=timekeeper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=timekeeper

# ---------------------------------------------------------------------------
# Auth.js / Microsoft Entra ID (Office 365 SSO)
# Create a single-tenant app registration, then see docs/SETUP.md.
# ---------------------------------------------------------------------------
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://timekeeper.example.com
AUTH_TRUST_HOST=true              # required behind your own reverse proxy
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# UPN of the first administrator. Granted SYSADMIN on their first sign-in.
BOOTSTRAP_ADMIN_UPN=

# ---------------------------------------------------------------------------
# Email (SMTP relay). Leave SMTP_HOST empty to log mail instead of sending.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TimeKeeper <timekeeper@example.com>"

# Base URL used in email links (defaults to AUTH_URL).
APP_URL=https://timekeeper.example.com

# ---------------------------------------------------------------------------
# Where the port is published.
#
# 127.0.0.1 (default) publishes on the server's loopback only, for a reverse
# proxy on the same host. Set 0.0.0.0 to reach it directly from your network,
# e.g. http://192.168.1.50:3000.
#
# Direct access is fine for a first look, but single sign-on will not work over
# plain http: Entra ID rejects http:// redirect URIs for anything other than
# localhost. AUTH_URL must exactly match the address people type, and for real
# use that means an HTTPS address through your proxy.
# ---------------------------------------------------------------------------
APP_BIND=127.0.0.1
APP_PORT=3000

# ---------------------------------------------------------------------------
# Scheduled jobs (in-process cron). Set to false on any replica that should
# not run them.
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true
TZ=Europe/London
